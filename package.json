{
    "name": "vscode-image-converter",
    "displayName": "VS Code Image Converter",
    "description": "Extension to convert images in Visual Studio Code",
    "version": "0.0.1",
    "engines": {
        "vscode": "^1.61.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onCommand:extension.bulkConvertImages"
    ],
    "main": "extension.js",
    "contributes": {
        "commands": [
            {
                "command": "extension.bulkConvertImages",
                "title": "Bulk Convert Images"
            }
        ],
        "menus": {
            "explorer/context": [
                {
                    "command": "extension.bulkConvertImages",
                    "group": "navigation"
                }
            ]
        }
    },
    
    "publisher": "ThomasTSWD",
    "repository": {
        "type": "git",
        "url": "https://github.com/ThomasTSWD/code-convert.git"
    },
    "icon": "icon.png",
    "devDependencies": {
        "@types/vscode": "^1.61.0"
    },
  
    "dependencies": {
        "sharp": "^0.33.2",
        "fs": "^0.0.1-security"
    }
}
